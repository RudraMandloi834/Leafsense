# ==============================================================================
# LeafSense Backend Environment Configuration Template
# Copy this file to `backend/.env` and update the values with your credentials.
# NOTE: Never commit `backend/.env` or expose real API keys in version control.
# ==============================================================================

# IBM Cloud / watsonx.ai Credentials
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model Configuration
# Primary IBM Granite generation/chat model
WATSONX_MODEL_ID=ibm/granite-4-h-small

# Primary IBM Granite multilingual embedding model for RAG knowledge base
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual

# Backend Server Configuration (Optional)
HOST=0.0.0.0
PORT=8000
